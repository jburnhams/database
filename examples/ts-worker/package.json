{
  "name": "ts-worker",
  "private": true,
  "type": "module",
  "description": "Example Cloudflare D1 app: Drizzle sqlite schema, generated migrations, tests on SQLite and D1 (Miniflare)",
  "omarchy-db": { "app": "ts_worker", "dialect": "sqlite", "schemaFile": "src/schema.ts", "migrations": "migrations" },
  "scripts": {
    "test": "vitest run",
    "test:d1": "OMARCHY_DB_TEST_ENGINE=d1 vitest run",
    "db:generate": "omarchy-db generate -m",
    "db:check": "omarchy-db check"
  },
  "dependencies": { "@omarchy/db": "file:../../ts", "drizzle-orm": "^0.45.4" },
  "devDependencies": { "better-sqlite3": "^13.0.3", "miniflare": "^4.20260730.0", "vitest": "^5.1.0", "typescript": "~5.9.0", "@types/node": "^24", "@cloudflare/workers-types": "^5.20261107.1" }
}
